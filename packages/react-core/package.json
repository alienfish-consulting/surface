{
  "name": "@alienfishconsulting/surface-react-core",
  "version": "1.0.0",
  "description": "Accessible layout, display, navigation, form, feedback, and overlay components for AlienFish Surface.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "sideEffects": [
    "./dist/*.css"
  ],
  "files": ["dist", "README.md", "LICENSE.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "repository": {"type":"git","url":"git+https://github.com/alienfish-consulting/surface.git","directory":"packages/react-core"},
  "homepage": "https://github.com/alienfish-consulting/surface#readme",
  "bugs": {"url":"https://github.com/alienfish-consulting/surface/issues"},
  "keywords": ["surface", "react", "design-system", "components", "accessibility"],
  "engines": {"node": ">=20"},
  "publishConfig": {"access":"public","registry":"https://registry.npmjs.org/"},
  "scripts": {
    "build": "node ../../tools/clean-package-dist.mjs react-core && tsc -p tsconfig.json && node ../../tools/copy-core-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@alienfishconsulting/surface-tokens": "workspace:*"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.2"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  }
}
