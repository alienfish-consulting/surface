{
  "name": "@enterprise-ui/react-designers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../tools/copy-package-css.mjs react-designers",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@enterprise-ui/contracts": "workspace:*",
    "@enterprise-ui/react-core": "workspace:*",
    "@enterprise-ui/react-data": "workspace:*"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.2"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
