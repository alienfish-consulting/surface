  "exceptions": [
    {
      "type": "ui.GridColumn",
      "reason": "Typed JSX configuration object consumed by grid components; it is serialized inside grid column arrays rather than as an independent document node."
    },
    {
      "type": "ui.ChartLegend",
      "reason": "Compositional chart helper whose items are derived from the owning chart series; standalone persisted placement is not meaningful."
    },
    {
      "type": "ui.ChartTooltip",
      "reason": "Ephemeral pointer/focus presentation derived from the owning chart datum; it is not stable persisted document state."
    }
