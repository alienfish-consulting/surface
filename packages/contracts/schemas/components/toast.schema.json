{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tone": {
      "enum": [
        "info",
        "success",
        "warning",
        "danger"
      ]
    }
  },
  "required": [
    "title"
  ],
  "additionalProperties": false
}
