{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "label": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "start": {
            "type": "number"
          },
          "duration": {
            "type": "number",
            "minimum": 0
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "label",
          "start",
          "duration"
        ],
        "additionalProperties": false
      }
    },
    "range": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "range"
  ],
  "additionalProperties": false
}
