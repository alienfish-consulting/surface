{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "label": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "lineNumbers": {
      "type": "boolean"
    },
    "highlightLines": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "required": [
    "label",
    "code"
  ],
  "additionalProperties": false
}
