{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90
    },
    "placeholder": {
      "type": "string",
      "maxLength": 160
    },
    "value": {
      "type": "string",
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "maxLength": 200
    },
    "required": {
      "type": "boolean"
    },
    "error": {
      "type": "string",
      "maxLength": 200
    }
  },
  "required": [
    "label"
  ],
  "additionalProperties": false
}
