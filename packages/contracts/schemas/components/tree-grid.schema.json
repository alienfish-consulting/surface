{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "width": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "sortable": {
            "type": "boolean"
          },
          "editable": {
            "type": "boolean"
          },
          "align": {
            "enum": [
              "start",
              "center",
              "end"
            ]
          }
        },
        "required": [
          "key",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "defaultExpandedIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "presentation": {
      "enum": [
        "auto",
        "table",
        "recordList"
      ]
    }
  },
  "required": [
    "title",
    "columns"
  ],
  "additionalProperties": false
}
