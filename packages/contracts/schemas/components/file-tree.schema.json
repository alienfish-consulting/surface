{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "label": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileNode"
      }
    },
    "selectedId": {
      "type": "string"
    },
    "defaultExpandedIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "nodes"
  ],
  "additionalProperties": false,
  "$defs": {
    "fileNode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "file",
            "folder"
          ]
        },
        "status": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileNode"
          }
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ],
      "additionalProperties": false
    }
  }
}
