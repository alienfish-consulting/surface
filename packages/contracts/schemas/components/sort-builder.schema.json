{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "operators": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "value",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "value": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "ascending",
              "descending"
            ]
          }
        },
        "required": [
          "field",
          "direction"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "fields"
  ],
  "additionalProperties": false
}
