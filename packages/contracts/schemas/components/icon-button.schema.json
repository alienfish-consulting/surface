{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "label": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "variant": {
      "enum": [
        "primary",
        "secondary",
        "ghost"
      ]
    },
    "disabled": {
      "type": "boolean"
    }
  },
  "required": [
    "label",
    "icon"
  ],
  "additionalProperties": false
}
