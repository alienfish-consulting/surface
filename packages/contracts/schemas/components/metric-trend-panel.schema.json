{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "value": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        }
      ]
    },
    "values": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "tone": {
      "enum": [
        "neutral",
        "success",
        "danger"
      ]
    }
  },
  "required": [
    "title",
    "value"
  ],
  "additionalProperties": false
}
