{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "label": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/treeNode"
      }
    },
    "selectedId": {
      "type": "string"
    },
    "defaultExpandedIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "label",
    "nodes"
  ],
  "additionalProperties": false,
  "$defs": {
    "treeNode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "disabled": {
          "type": "boolean"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/treeNode"
          }
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    }
  }
}
