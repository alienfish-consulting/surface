      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "time": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "tone": {
            "enum": [
              "neutral",
              "success",
              "warning",
              "danger"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "time"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [],
  "additionalProperties": false
}
