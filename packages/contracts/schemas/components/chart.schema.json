{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "string"
          },
          "y": {
            "type": "number"
          },
          "series": {
            "type": "string"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "additionalProperties": false
      }
    },
    "type": {
      "enum": [
        "bar",
        "line",
        "area"
      ]
    },
    "height": {
      "type": "number",
      "minimum": 80
    },
    "valueLabel": {
      "type": "string"
    },
    "emptyText": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "additionalProperties": false
}
