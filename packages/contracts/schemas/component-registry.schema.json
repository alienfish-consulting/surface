{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui.example.invalid/schemas/component-registry/1.0.0",
  "type": "object",
  "required": [
    "registryVersion",
    "components"
  ],
  "properties": {
    "registryVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "version",
          "package",
          "purpose",
          "propsSchema",
          "allowedChildren",
          "bindings",
          "events",
          "states",
          "responsive"
        ],
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^ui\\.[A-Za-z][A-Za-z0-9]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "package": {
            "enum": [
              "ui-react",
              "ui-data",
              "ui-ai",
              "ui-operations",
              "ui-ai",
              "ui-designers"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 5
          },
          "propsSchema": {
            "type": "string",
            "pattern": "^schemas/components/[a-z0-9-]+\\.schema\\.json$"
          },
          "allowedChildren": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ui\\.[A-Za-z][A-Za-z0-9]*$"
            },
            "uniqueItems": true
          },
          "bindings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^on[A-Z][A-Za-z0-9]*$"
            },
            "uniqueItems": true
          },
          "states": {
            "type": "array",
            "items": {
              "enum": [
                "interaction",
                "data",
                "connectivity",
                "freshness",
                "execution",
                "approval",
                "validation",
                "editing",
                "operation"
              ]
            },
            "uniqueItems": true
          },
          "responsive": {
            "enum": [
              "container",
              "record-list",
              "stack",
              "adaptive-panel",
              "horizontal-scroll-to-stack",
              "scroll",
              "wrap",
              "pan-to-stack",
              "grid",
              "none"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
