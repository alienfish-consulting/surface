{
  "name": "@alienfishconsulting/surface-react-renderer",
  "version": "1.0.0",
  "description": "Explicit adapters that render validated AlienFish Surface design documents with React.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {"type":"git","url":"git+https://github.com/alienfish-consulting/surface.git","directory":"packages/react-renderer"},
  "homepage": "https://github.com/alienfish-consulting/surface#readme",
  "bugs": {"url":"https://github.com/alienfish-consulting/surface/issues"},
  "keywords": ["surface", "react", "renderer", "json-schema", "design-system"],
  "engines": {"node": ">=20"},
  "publishConfig": {"access":"public","registry":"https://registry.npmjs.org/"},
  "scripts": {
    "build": "node ../../tools/clean-package-dist.mjs react-renderer && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@alienfishconsulting/surface-contracts": "workspace:*",
    "@alienfishconsulting/surface-react-core": "workspace:*",
    "@alienfishconsulting/surface-react-data": "workspace:*",
    "@alienfishconsulting/surface-react-operations": "workspace:*",
    "@alienfishconsulting/surface-react-ai": "workspace:*",
    "@alienfishconsulting/surface-react-designers": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  }
}
