{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui.example.invalid/schemas/patch-proposal/1.0.0",
  "type": "object",
  "required": [
    "proposalId",
    "documentId",
    "schemaVersion",
    "registryVersion",
    "baseRevision",
    "operations",
    "rationale"
  ],
  "properties": {
    "proposalId": {
      "type": "string",
      "minLength": 1
    },
    "documentId": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "registryVersion": {
      "type": "string",
      "minLength": 1
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "op",
              "path",
              "value"
            ],
            "properties": {
              "op": {
                "const": "test"
              },
              "path": {
                "$ref": "#/$defs/pointer"
              },
              "value": {}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "op",
              "path",
              "value"
            ],
            "properties": {
              "op": {
                "const": "add"
              },
              "path": {
                "$ref": "#/$defs/pointer"
              },
              "value": {}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "op",
              "path",
              "value"
            ],
            "properties": {
              "op": {
                "const": "replace"
              },
              "path": {
                "$ref": "#/$defs/pointer"
              },
              "value": {}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "op",
              "path"
            ],
            "properties": {
              "op": {
                "const": "remove"
              },
              "path": {
                "$ref": "#/$defs/pointer"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "op",
              "from",
              "path"
            ],
            "properties": {
              "op": {
                "enum": [
                  "move",
                  "copy"
                ]
              },
              "from": {
                "$ref": "#/$defs/pointer"
              },
              "path": {
                "$ref": "#/$defs/pointer"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "pointer": {
      "type": "string",
      "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
    }
  }
}
