{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "key",
          "label"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "sortable": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "presentation": {
      "enum": [
        "auto",
        "table",
        "recordList"
      ]
    },
    "selectable": {
      "type": "boolean"
    }
  },
  "required": [
    "title",
    "columns"
  ],
  "additionalProperties": false
}
