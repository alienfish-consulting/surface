{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true, "resolveJsonModule": true, "esModuleInterop": true,
    "skipLibCheck": true, "jsx": "react-jsx", "declaration": true,
    "forceConsistentCasingInFileNames": true
  }
}
